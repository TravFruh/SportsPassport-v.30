{
  "name": "Travis' Stadium Passport Cloud",
  "short_name": "Stadium Cloud",
  "description": "A personal stadium tracker with one collectible passport stamp for every game visit.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "id": "./index.html",
  "orientation": "any",
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}